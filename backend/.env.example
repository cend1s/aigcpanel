PORT=3100
HOST=127.0.0.1
DB_FILE=data/app.db
# 对外访问地址（支付回调、跳转用），生产必须是公网 https 地址
BASE_URL=http://127.0.0.1:3100
# 1 元对应的额度
QUOTA_PER_YUAN=1000
# 供应商返回的图片落盘目录
FILES_DIR=data/files
# 管理后台构建产物（admin/dist），存在时挂载到 /admin/
ADMIN_DIR=../admin/dist

# 易支付类聚合通道（三项都配置才启用）
EPAY_GATEWAY=
EPAY_PID=
EPAY_KEY=

# 仅开发：启用模拟支付与模拟云端模型
PAYMENT_MOCK=0
MOCK_PROVIDER=0

# ── 登录安全 ──
APP_NAME=AIGCPanel
# 注册必须邮件验证码（默认开启）；仅本地开发可设为 0
REQUIRE_EMAIL_CODE=1
# 部署在 nginx 等反向代理后面时设为 1，限流才能按真实客户端 IP 计数
TRUST_PROXY=0
# 邮件（发送验证码）。未配置时：开发环境把验证码打印在服务日志里；生产环境（NODE_ENV=production）拒绝启动
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
