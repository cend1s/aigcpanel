PORT=3100
HOST=127.0.0.1
DB_FILE=data/app.db
# 对外访问地址（支付回调、跳转用），生产必须是公网 https 地址
BASE_URL=http://127.0.0.1:3100
# 1 元对应的额度
QUOTA_PER_YUAN=1000
# 供应商返回的图片落盘目录
FILES_DIR=data/files
# 管理后台构建产物（admin/dist），存在时挂载到 /admin/
ADMIN_DIR=../admin/dist

# 易支付类聚合通道（三项都配置才启用）
EPAY_GATEWAY=
EPAY_PID=
EPAY_KEY=

# 仅开发：启用模拟支付与模拟云端模型
PAYMENT_MOCK=0
MOCK_PROVIDER=0
